enum EntryType {
  DEBIT
  CREDIT
}

enum FlowType {
  Wallet_Deposit
  Wallet_Withdraw
  Investment_Flow
}

enum TransactionType {
  Wallet_Deposit
  Wallet_Withdraw
  Surrender_Equity
  Purchase_Equity
  Withdraw_Equity
}

model Wallet {
  id        String  @id @default(uuid())
  amount    Decimal @default(0.0)
  onHold    Decimal @default(0.0)
  accountId String  @unique
  account   Account @relation("Wallet", fields: [accountId], references: [id])
}

model Transaction {
  id              String          @id @default(uuid())
  transactionType TransactionType
  amount          Decimal
  date            DateTime        @default(now())
  description     String
  accountId       String
  account         Account         @relation("Transaction", fields: [accountId], references: [id])
  Entry           Entry[]
}

model Journal {
  id             String        @id @default(uuid())
  name           String        @unique
  flowType       FlowType
  raisingFundsId String?       @unique
  raisingFunds   RaisingFunds? @relation(fields: [raisingFundsId], references: [id])
  Entry          Entry[]
}

model Entry {
  id            String        @id @default(uuid())
  transactionId String
  transaction   Transaction   @relation(fields: [transactionId], references: [id])
  date          DateTime      @default(now())
  description   String?
  amount        Decimal
  entryType     EntryType
  journalId     String
  journal       Journal       @relation(fields: [journalId], references: [id], onDelete: Cascade)
  ledgerId      String
  ledger        LedgerAccount @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
}

model LedgerAccount {
  id           String  @id @default(uuid())
  name         String
  totalBalance Decimal @default(0)
  accountId    String  @unique
  account      Account @relation("LedgerAccount", fields: [accountId], references: [id])
  Entry        Entry[]
}

