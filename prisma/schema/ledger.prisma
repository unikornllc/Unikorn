enum EntryType {
  DEBIT
  CREDIT
}

enum TransactionType {
  Wallet_Deposit
  Wallet_Withdraw
  Surrender_Equity
  Purchase_Equity
  Withdraw_Equity
}

model Wallet {
  id        String          @id @default(uuid())
  amount    Decimal         @default(0.0)
  onHold    Decimal         @default(0.0)
  userId    String          @unique
  user      User            @relation("Wallet", fields: [userId], references: [id])
  companyId String          @unique
  company   Company_Profile @relation("CompanyWallet", fields: [companyId], references: [id])
}

model Transaction {
  id              String           @id @default(uuid())
  transactionType TransactionType
  amount          Decimal
  date            DateTime         @default(now())
  description     String
  senderCompanyId String?
  senderCompany   Company_Profile? @relation("Transaction", fields: [senderCompanyId], references: [id])
  senderUserId    String?
  senderUser      User?            @relation("Transaction", fields: [senderUserId], references: [id])
  ledgers         LedgerEntry[]
  JournalEntry    JournalEntry[]
}

model Journal {
  id           String         @id @default(uuid())
  totalBalance Decimal        @default(0)
  JournalEntry JournalEntry[]
  LedgerEntry  LedgerEntry[]
}

model JournalEntry {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  date          DateTime    @default(now())
  description   String?
  amount        Decimal
  entryType     EntryType
  journalId     String
  journal       Journal     @relation(fields: [journalId], references: [id], onDelete: Cascade)
}

model LedgerAccount {
  id           String           @id @default(uuid())
  name         String
  totalBalance Decimal          @default(0)
  companyId    String?          @unique
  company      Company_Profile? @relation("LedgerAccountCompany", fields: [companyId], references: [id])
  userId       String?          @unique
  user         User?            @relation("LedgerAccountUser", fields: [userId], references: [id])
  LedgerEntry  LedgerEntry[]
}

model LedgerEntry {
  id            String        @id @default(uuid())
  date          DateTime      @default(now())
  description   String
  amount        Decimal       @default(0.0)
  transactionId String
  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  type          EntryType
  journalId     String
  journal       Journal       @relation(fields: [journalId], references: [id], onDelete: Cascade)
  ledgerId      String
  ledger        LedgerAccount @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
}
