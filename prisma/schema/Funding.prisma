enum InvestorType {
  User
  Company
}

enum OfferStatus {
  Pending
  Accepted
  Rejected
}

enum ContractStatus {
  Pending
  Active
  Completed
  Failed
}

model Financial {
  id                 String         @id @default(uuid())
  valuation          Float
  investors          String[]
  totalFundingAmount Float
  fundingRounds      FundingRound[]
  company            Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId          String         @unique
}

model RaisingFunds {
  id                String            @id @default(uuid())
  equityPercentage  Float
  fundingAmount     Float
  pricePerPortion   Float
  remainingPortions Int               @default(10)
  totalPortions     Int               @default(10)
  status            ContractStatus    @default(Pending)
  envelopeId        String?           @unique
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId         String
  fundraisers       Fundraiser[]
  investmentOffers  InvestmentOffer[]
  journal           Journal?
  fundingRound      FundingRound?     @relation(fields: [fundingRoundId], references: [id], onDelete: Cascade)
  fundingRoundId    String?           @unique
  posts             Post[]

  date      DateTime
  createdAt DateTime  @default(now())
  endedAt   DateTime?
}

model FundingRound {
  id               String        @id @default(uuid())
  type             String
  fundingAmount    Float
  equityPercentage Float
  roundDate        DateTime
  leadInvestors    String[]
  financial        Financial     @relation(fields: [financialId], references: [id], onDelete: Cascade)
  financialId      String
  raisingFunds     RaisingFunds?
}

model Fundraiser {
  id String @id @default(uuid())

  investorType   InvestorType
  investorUser   User?        @relation("UserInvestments", fields: [investorUserId], references: [id], onDelete: Cascade)
  investorUserId String?

  investorCompany   Company? @relation("CompanyInvestments", fields: [investorCompanyId], references: [id], onDelete: Cascade)
  investorCompanyId String?

  raisingFunds   RaisingFunds @relation(fields: [raisingFundsId], references: [id], onDelete: Cascade)
  raisingFundsId String

  equityPercentage Float
  fundingAmount    Float
  portions         Int
  pricePerPortion  Float
  date             DateTime
  status           ContractStatus @default(Pending)
  envelopeId       String?
  investment       Investment?    @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  investmentId     String?        @unique

  @@unique([raisingFundsId, investorUserId, investorCompanyId])
}

model Investment {
  id               String      @id @default(uuid())
  companyName      String
  amount           Float
  equityPercentage Float
  date             DateTime    @default(now())
  fundraiser       Fundraiser?
  accountId        String
  account          Account     @relation("AccountInvestments", fields: [accountId], references: [id], onDelete: Cascade)
}

model InvestmentOffer {
  id String @id @default(uuid())

  investorType InvestorType

  investorUser   User?   @relation("UserOffers", fields: [investorUserId], references: [id], onDelete: Cascade)
  investorUserId String?

  investorCompany   Company? @relation("CompanyOffers", fields: [investorCompanyId], references: [id], onDelete: Cascade)
  investorCompanyId String?

  raisingFunds   RaisingFunds @relation(fields: [raisingFundsId], references: [id], onDelete: Cascade)
  raisingFundsId String

  portions               Int
  offeredPricePerPortion Float
  totalOfferedPrice      Float
  status                 OfferStatus @default(Pending)
  date                   DateTime    @default(now())
}
