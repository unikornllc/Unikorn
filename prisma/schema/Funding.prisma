enum InvestorType {
  User
  Company
}

enum OfferStatus {
  Pending
  Accepted
  Rejected
  Cancelled
}

enum Contract_Status {
  Pending
  Active
  Completed
  Failed
}

model Raising_Funds {
  id                String          @id @default(uuid())
  equityPercentage  Float
  fundingAmount     Float
  pricePerPortion   Float
  remainingPortions Int             @default(10)
  totalPortions     Int             @default(10)
  date              DateTime
  status            Contract_Status @default(Pending)
  envelopeId        String          @unique
  company           Company_Profile @relation(fields: [companyId], references: [id])
  companyId         String
  fundraisers       Fundraiser[]
  investmentOffers  InvestmentOffer[]
}

model Fundraiser {
  id                 String          @id @default(uuid())

  investorType       InvestorType

  investorUser       User?           @relation("UserInvestments",fields: [investorUserId], references: [id])
  investorUserId     String?

  investorCompany    Company_Profile? @relation("CompanyInvestments", fields: [investorCompanyId], references: [id])
  investorCompanyId  String?

  raisingFunds       Raising_Funds   @relation(fields: [raisingFundsId], references: [id])
  raisingFundsId     String

  equityPercentage   Float
  fundingAmount      Float
  portions           Int
  pricePerPortion    Float
  date               DateTime
  status             Contract_Status @default(Pending)
  envelopeId         String          @unique
}

model InvestmentOffer {
  id                        String          @id @default(uuid())

  investorType              InvestorType

  investorUser              User?           @relation("UserOffers",fields: [investorUserId], references: [id])
  investorUserId            String?

  investorCompany           Company_Profile? @relation("CompanyOffers",fields: [investorCompanyId], references: [id])
  investorCompanyId         String?

  raisingFunds              Raising_Funds   @relation(fields: [raisingFundsId], references: [id])
  raisingFundsId            String

  portions                  Int
  offeredPricePerPortion    Float
  totalOfferedPrice         Float
  status                    OfferStatus     @default(Pending)
  date                      DateTime        @default(now())
}

model Funding_Round {
  id             String    @id @default(uuid())
  type           String
  funding_amount Float
  round_date     DateTime
  lead_investors String[]
  financial      Financial @relation(fields: [financialId], references: [id])
  financialId    String
}

model Financial {
  id                   String          @id @default(uuid())
  valuation            Float
  investors            String[]
  total_funding_amount Float
  funding_rounds       Funding_Round[]
  company              Company_Profile @relation(fields: [companyId], references: [id])
  companyId            String          @unique
}
