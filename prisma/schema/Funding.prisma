enum InvestorType {
  User
  Company
}

enum OfferStatus {
  Pending
  Accepted
  Rejected
}

enum ContractStatus {
  Pending
  Active
  Completed
  Failed
}

model RaisingFunds {
  id                String            @id @default(uuid())
  equityPercentage  Float
  fundingAmount     Float
  pricePerPortion   Float
  remainingPortions Int               @default(10)
  totalPortions     Int               @default(10)
  date              DateTime
  status            ContractStatus    @default(Pending)
  envelopeId        String            @unique
  company           Company           @relation(fields: [companyId], references: [id])
  companyId         String
  fundraisers       Fundraiser[]
  investmentOffers  InvestmentOffer[]
  journal           Journal?
}

model Fundraiser {
  id String @id @default(uuid())

  investorType   InvestorType
  investorUser   User?        @relation("UserInvestments", fields: [investorUserId], references: [id])
  investorUserId String?

  investorCompany   Company? @relation("CompanyInvestments", fields: [investorCompanyId], references: [id])
  investorCompanyId String?

  raisingFunds   RaisingFunds @relation(fields: [raisingFundsId], references: [id])
  raisingFundsId String

  equityPercentage Float
  fundingAmount    Float
  portions         Int
  pricePerPortion  Float
  date             DateTime
  status           ContractStatus @default(Pending)
  envelopeId       String

  @@unique([raisingFundsId, investorUserId, investorCompanyId])
}

model InvestmentOffer {
  id String @id @default(uuid())

  investorType InvestorType

  investorUser   User?   @relation("UserOffers", fields: [investorUserId], references: [id])
  investorUserId String?

  investorCompany   Company? @relation("CompanyOffers", fields: [investorCompanyId], references: [id])
  investorCompanyId String?

  raisingFunds   RaisingFunds @relation(fields: [raisingFundsId], references: [id])
  raisingFundsId String

  portions               Int
  offeredPricePerPortion Float
  totalOfferedPrice      Float
  status                 OfferStatus @default(Pending)
  date                   DateTime    @default(now())
}

model FundingRound {
  id            String    @id @default(uuid())
  type          String
  fundingAmount Float
  roundDate     DateTime
  leadInvestors String[]
  financial     Financial @relation(fields: [financialId], references: [id])
  financialId   String
}

model Financial {
  id                 String         @id @default(uuid())
  valuation          Float
  investors          String[]
  totalFundingAmount Float
  fundingRounds      FundingRound[]
  company            Company        @relation(fields: [companyId], references: [id])
  companyId          String         @unique
}
