enum AccountType {
  User
  Company
}

model Account {
  id            String         @id @unique @default(uuid())
  googleId      String?        @unique
  username      String         @unique
  email         String         @unique
  password      String
  mobileNumber  String?        @unique
  emailVerified Boolean        @default(false)
  role          AccountType
  company       Company?
  user          User?
  loginDevices  LoginDevices[]
  wallet        Wallet?        @relation("Wallet")
  ledgerAccount LedgerAccount? @relation("LedgerAccount")
  transaction   Transaction[]  @relation("Transaction")
  following     Follow[]       @relation("follower")
  followedBy    Follow[]       @relation("following")
  file          File[]

  //chat relations
  sentMessages           Message[]         @relation("SentMessages")
  participantIn          ChatParticipant[] // change name 3ashan yahia medaye2
  readReceipts           ReadReceipt[]
  sentFriendRequests     FriendRequest[]   @relation("Sender")
  receivedFriendRequests FriendRequest[]   @relation("Receiver")
  blockedUsers           BlockedUser[]     @relation("Blocker")
  blockedBy              BlockedUser[]     @relation("Blocked")
  reportedUsers          ReportedUser[]    @relation("Reporter")
  reportedBy             ReportedUser[]    @relation("Reported")

  //posting relations
  posts       Post[]     @relation("AccountPosts")
  comments    Comment[]  @relation("AccountComments")
  likes       Like[]
  reposts     Repost[]
  pollsVoted  PollVote[]
  reportsMade Report[]   @relation("ReporterAccount")

  @@index([id])
  @@index([username])
}

model File {
  id         String   @id @default(uuid())
  fileName   String
  filePath   String
  fileType   String
  uploadedAt DateTime @default(now())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([fileName, accountId])
}
