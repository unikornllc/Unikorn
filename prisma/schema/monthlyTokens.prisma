enum TokenType {
    INVESTMENT
    OFFER
    FUNDRAISE
}

enum TokenAction {
    CONSUME
    REFUND
}

model MonthlyTokens {
    id                         String   @id @default(uuid())
    accountId                  String   @unique
    investmentTokensAvailable  Int      @default(3)
    fundraisingTokensAvailable Int      @default(3)
    lastReset                  DateTime @default(now())
    account                    Account  @relation(fields: [accountId], references: [id])
}

model TokensUsageLog {
    id        String      @id @default(uuid())
    usedAt    DateTime    @default(now())
    accountId String
    tokenType TokenType
    action    TokenAction @default(CONSUME)
    account   Account     @relation(fields: [accountId], references: [id])
}
