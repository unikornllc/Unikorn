enum Company_Type {
  Profit
  NonProfit
  Private
  Public
}

enum Contract_Status{
  Pending
  Active
  Completed
  Failed
}

enum companyTier {
  Hunter
  Holder
}
model Company_Profile {
  id                  String                @id @default(uuid())
  name                String
  username            String                @unique
  email               String                @unique
  password            String
  description         String                @db.VarChar(500)
  website             String
  founded             DateTime
  type                Company_Type          @default(Public)
  hqlocation          String
  industry            String
  emailVerify         Boolean               @default(false)
  verified            Boolean               @default(false)
  tier                companyTier                  @default(Holder)
  board_members       String[]
  advisors            String[]
  founders            Founder[]
  key_employees       Key_Employees[]
  product_information Product_Information[]
  financials          Financial?
  activities          Activity[]
  company_file        Company_File[]
  followers           UserFollowsCompany[]
  logindevices        LoginDevices[]
  raising_Funds       Raising_Funds[]
}

model Raising_Funds {
  id                  String          @id @default(uuid())
  equityPercentage    Float
  fundingAmount       Float
  remainingPortions   Int  @default(10)
  totalPortions       Int  @default(10)
  date                DateTime
  status              Contract_Status @default(Pending)
  envelopeId          String          @unique 
  company             Company_Profile @relation(fields: [companyId], references: [id])
  companyId           String
  fundraiser          Fundraiser[]
}

model Fundraiser{
  id                String          @id @default(uuid())
  user              User            @relation(fields: [userId], references: [id])
  userId            String
  raising_funds     Raising_Funds   @relation(fields: [raisingFundsId], references: [id])
  raisingFundsId    String
  equityPercentage  Float
  fundingAmount     Float
  date              DateTime
  status            Contract_Status @default(Pending)
  envelopeId        String          @unique
}

model Founder {
  id               String          @id @default(uuid())
  name             String
  role             String
  crunch_base_link String
  company          Company_Profile @relation(fields: [companyId], references: [id])
  companyId        String
}

model Key_Employees {
  id        String          @id @default(uuid())
  name      String
  role      String
  company   Company_Profile @relation(fields: [companyId], references: [id])
  companyId String
}

model Funding_Round {
  id             String    @id @default(uuid())
  type           String
  funding_amount Float
  round_date     DateTime
  lead_investors String[]
  financial      Financial @relation(fields: [financialId], references: [id])
  financialId    String
}

model Financial {
  id                   String          @id @default(uuid())
  valuation            Float
  investors            String[]
  total_funding_amount Float
  funding_rounds       Funding_Round[]
  company              Company_Profile @relation(fields: [companyId], references: [id])
  companyId            String          @unique
}

model Product_Information {
  id           String          @id @default(uuid())
  product      String
  market       String
  partnerships String[]
  company      Company_Profile @relation(fields: [companyId], references: [id])
  companyId    String
}

model Activity {
  id          String          @id @default(uuid())
  title       String
  description String          @db.VarChar(500)
  company     Company_Profile @relation(fields: [companyId], references: [id])
  companyId   String
}

model Company_File {
  id         String          @id @default(uuid())
  fileName   String
  filePath   String
  fileType   String
  uploadedAt DateTime        @default(now())
  companyId  String
  company    Company_Profile @relation(fields: [companyId], references: [id])

  @@unique([fileName, companyId])
}
