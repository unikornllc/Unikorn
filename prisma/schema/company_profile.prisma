enum Company_Type {
  Profit
  NonProfit
  Private
  Public
}

enum companyTier {
  Hunter
  Holder
}

model Company_Profile {
  id                  String                @id @default(uuid())
  name                String
  username            String                @unique
  email               String                @unique
  password            String
  description         String                @db.VarChar(500)
  website             String
  founded             DateTime
  type                Company_Type          @default(Public)
  hqlocation          String
  industry            String
  emailVerify         Boolean               @default(false)
  verified            Boolean               @default(false)
  tier                companyTier           @default(Holder)
  board_members       String[]
  advisors            String[]
  founders            Founder[]
  key_employees       Key_Employees[]
  product_information Product_Information[]
  financials          Financial?
  activities          Activity[]
  company_file        Company_File[]
  followers           UserFollowsCompany[]
  logindevices        LoginDevices[]
  raising_Funds       Raising_Funds[]
  fundraiser          Fundraiser[]          @relation("CompanyInvestments")
  investmentOffers    InvestmentOffer[]     @relation("CompanyOffers")
  wallet              Wallet?               @relation("CompanyWallet")
  Transaction         Transaction[]         @relation("Transaction")
  LedgerAccount       LedgerAccount?        @relation("LedgerAccountCompany")
}

model Founder {
  id               String          @id @default(uuid())
  name             String
  role             String
  crunch_base_link String
  company          Company_Profile @relation(fields: [companyId], references: [id])
  companyId        String
}

model Key_Employees {
  id        String          @id @default(uuid())
  name      String
  role      String
  company   Company_Profile @relation(fields: [companyId], references: [id])
  companyId String
}

model Product_Information {
  id           String          @id @default(uuid())
  product      String
  market       String
  partnerships String[]
  company      Company_Profile @relation(fields: [companyId], references: [id])
  companyId    String
}

model Activity {
  id          String          @id @default(uuid())
  title       String
  description String          @db.VarChar(500)
  company     Company_Profile @relation(fields: [companyId], references: [id])
  companyId   String
}

model Company_File {
  id         String          @id @default(uuid())
  fileName   String
  filePath   String
  fileType   String
  uploadedAt DateTime        @default(now())
  companyId  String
  company    Company_Profile @relation(fields: [companyId], references: [id])

  @@unique([fileName, companyId])
}
