enum Role {
  User
  Company
}

model RefreshTokenValid {
  sid       String   @id
  profileId String
  ip        String
  browser   String
  os        String
  expire    DateTime
  role      Role
}

model TokenBlacklist {
  token  String   @id
  expire DateTime
}

model LoginDevices {
  id        String  @id @default(uuid())
  ip        String
  browser   String
  os        String
  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  @@unique([ip, browser, os, accountId])
}

model BlacklistedPasswordToken {
  id        Int      @id @default(autoincrement())
  jti       String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
