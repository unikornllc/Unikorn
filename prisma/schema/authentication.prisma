enum Role {
  User
  Company
}

model RefreshTokenValid {
  sid       String   @id
  profileId String
  expire    DateTime
  role      Role
}

model TokenBlacklist {
  token     String   @id
  profileId String
  expire    DateTime
}

model LoginDevices {
  id        String           @id @default(uuid())
  ip        String
  browser   String
  os        String
  userId    String?
  companyId String?
  user      User?            @relation(fields: [userId], references: [id])
  company   Company_Profile? @relation(fields: [companyId], references: [id])
}

model BlacklistedPasswordToken {
  id        Int      @id @default(autoincrement())
  jti       String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}