model ProductInformation {
  id           String   @id @default(uuid())
  product      String
  market       String
  partnerships String[]
  company      Company  @relation(fields: [companyId], references: [id])
  companyId    String
}

model Activity {
  id          String  @id @default(uuid())
  title       String
  description String  @db.VarChar(500)
  company     Company @relation(fields: [companyId], references: [id])
  companyId   String
}

model CompanyFile {
  id         String   @id @default(uuid())
  fileName   String
  filePath   String
  fileType   String
  uploadedAt DateTime @default(now())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])

  @@unique([fileName, companyId])
}
