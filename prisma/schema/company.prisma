enum CompanyType {
  Profit
  NonProfit
  Private
  Public
}

enum CompanyTier {
  Hunter
  Holder
}

enum CompanyPersonnel {
  Founder
  Advisor
  BoardMemeber
  KeyEmployee
}

model Company {
  id                 String               @id @unique @default(uuid())
  account            Account              @relation(fields: [id], references: [id])
  name               String
  description        String               @db.VarChar(600)
  website            String
  founded            DateTime
  type               CompanyType          @default(Public)
  hqLocation         String
  industry           String
  verified           Boolean              @default(false)
  tier               CompanyTier          @default(Holder)
  personnel          Personnel[]
  productInformation ProductInformation[]
  financials         Financial?
  activities         Activity[]
  companyFile        CompanyFile[]
  raisingFunds       RaisingFunds[]
  fundraiser         Fundraiser[]         @relation("CompanyInvestments")
  investmentOffers   InvestmentOffer[]    @relation("CompanyOffers")
}

model Personnel {
  id             String           @id @default(uuid())
  name           String
  role           CompanyPersonnel
  crunchBaseLink String
  company        Company          @relation(fields: [companyId], references: [id])
  companyId      String
  user           User?            @relation(fields: [userId], references: [id])
  userId         String?
}

