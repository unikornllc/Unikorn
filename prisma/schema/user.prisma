enum Title {
  Mr
  Mrs
  Ms
}

enum Degree {
  NONE
  BA
  BSc
  MA
  MSc
  MBA
  PhD
}

enum LanguageProficiency {
  Beginner
  Intermediate
  Proficient
}

enum SocialMediaPlatforms {
  LinkedIn
  X
  Meetup
}

enum Tier {
  Pro
  Standard
}

model User {
  id                    String                  @id @default(uuid())  @unique
  account               Account                 @relation(fields: [id], references: [id])
  name                  String
  description           String                  @db.VarChar(600)
  title                 Title                   @default(Mr)
  tier                  Tier                    @default(Standard)
  expertise             Expertise[]
  education             Education[]
  interest              Interest[]
  corporateExperience   CorporateExperience[]
  startupExperience     StartupExperience[]
  certificationsCourses CertificationsCourses[]
  language              Language[]
  socialMedia           SocialMedia[]
  userFile              UserFile[]
  calendlyIntegration   CalendlyIntegration?
  fundraiser            Fundraiser[]            @relation("UserInvestments")
  investmentOffers      InvestmentOffer[]       @relation("UserOffers")
}

model Expertise {
  id     String @id @default(uuid())
  field  String
  user   User   @relation(fields: [userId], references: [id])
  userId String
}

model Education {
  id          String @id @default(uuid())
  degree      Degree @default(NONE)
  institution String
  user        User   @relation(fields: [userId], references: [id])
  userId      String
}

model Interest {
  id     String @id @default(uuid())
  name   String
  user   User   @relation(fields: [userId], references: [id])
  userId String
}

model CorporateExperience {
  id               String   @id @default(uuid())
  jobTitle         String
  companyName      String
  startDate        DateTime
  endDate          DateTime?
  responsibilities String
  user             User     @relation(fields: [userId], references: [id])
  userId           String
}

model StartupExperience {
  id          String @id @default(uuid())
  startupName String
  role        String
  description String @db.VarChar(500)
  user        User   @relation(fields: [userId], references: [id])
  userId      String
}

model CertificationsCourses {
  id             String   @id @default(uuid())
  title          String
  institution    String
  completionDate DateTime
  focusArea      String
  user           User     @relation(fields: [userId], references: [id])
  userId         String
}

model Language {
  id          String              @id @default(uuid())
  language    String
  proficiency LanguageProficiency @default(Beginner)
  user        User                @relation(fields: [userId], references: [id])
  userId      String
}

model SocialMedia {
  id       String               @id @default(uuid())
  platform SocialMediaPlatforms @default(X)
  url      String
  user     User                 @relation(fields: [userId], references: [id])
  userId   String
}

model UserFile {
  id         String   @id @default(uuid())
  fileName   String
  filePath   String
  fileType   String
  uploadedAt DateTime @default(now())
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  @@unique([fileName, userId])
}
